# Nextcloud admin credentials
NEXTCLOUD_ADMIN_USER=your_admin_username
NEXTCLOUD_ADMIN_PASSWORD=your_admin_password

# Nextcloud data directory (used by manage_volume.sh -v flag)
NEXTCLOUD_DATA_DIR=/var/nextcloud_data

# Port to expose Nextcloud on the host (default 8080)
PORT=8080

# Trusted domains (space-separated: localhost and your Cloudflare tunnel hostname)
NEXTCLOUD_TRUSTED_DOMAINS=localhost your-tunnel.example.com

# MariaDB credentials
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=your_db_password

# Cloudflare Tunnel token (get from Cloudflare Zero Trust dashboard)
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token